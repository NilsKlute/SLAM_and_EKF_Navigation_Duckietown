<launch>
    <arg name="pkg_name" default="navigation" doc="name of the package"/>
    <arg name="param_file_name" default="default" doc="Specify a param file. ex:megaman." />
    <arg name="node_name" default="ekf_localization_node" doc="name of the node"/>
    <arg name="veh" doc="Name of vehicle. ex: megaman"/>

    <group ns="$(arg veh)">
        <node pkg="$(arg pkg_name)" type="$(arg node_name).py" name="$(arg node_name)" output="screen"
              required="true">
              <rosparam command="load" file="$(find navigation)/config/ekf_localization_node/$(arg param_file_name).yaml"/>
              <rosparam command="load" file="$(find navigation)include/navigation/map.yaml"/>
        </node>
    </group>
</launch>
