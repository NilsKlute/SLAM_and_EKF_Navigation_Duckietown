<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="veh" default="$(env VEHICLE_NAME)"/>
  <arg name="demo_name" value="lane_following_pid"/>
  <arg name="verbose" default="true"/>
  <include file="$(find duckietown_demos)/launch/master.launch">
    <!-- Basic parameters -->
    <arg name="veh"            value="$(arg veh)"/>
    <arg name="demo_name"      value="$(arg demo_name)"/>
    <arg name="param_file_name" default="default"/>
    <arg name="visualization"  value="true"/>

    <!-- Use stripped-down FSM: NORMAL_JOYSTICK_CONTROL <-> LANE_FOLLOWING only, no stop-line transition -->
    <arg name="fsm_file_name"  value="lane_following_only"/>
    <arg name="fsm"            value="true"/>
    <arg name="/fsm/logic_gate" value="false"/>

    <!-- Vehicle-specific configs -->
    <arg name="line_detector_param_file_name"       default="$(arg veh)"/>
    <arg name="lane_controller_param_file_name"     default="$(arg veh)"/>

    <!-- Basic functionalities -->
    <arg name="anti_instagram" default="true"/>
    <arg name="/camera/raw"    value="true"/>
    <arg name="/camera/rect"   value="true"/>
    <arg name="LED"            value="true"/>
    <arg name="/LED/detector"  value="false"/>
    <arg name="/LED/emitter"   value="true"/>

    <!-- Lane following stack — stop_line_filter disabled so the robot never stops -->
    <arg name="lane_following"                    value="true"/>
    <arg name="/lane_following/line_detection"    value="true"/>
    <arg name="/lane_following/ground_projection" value="true"/>
    <arg name="/lane_following/lane_filter"       value="true"/>
    <arg name="/lane_following/lane_controller"   value="true"/>
    <arg name="/lane_following/stop_line_filter"  value="false"/>

    <!-- Intersection stack off -->
    <arg name="unicorn_intersection"       value="false"/>
    <arg name="apriltags"                  value="false"/>
    <arg name="apriltags_random"           value="false"/>
    <arg name="intersection_type_detector" value="false"/>

    <!-- Navigation / planning off -->
    <arg name="graph_planner"    value="false"/>
    <arg name="target_selection" value="false"/>

    <!-- Localization off -->
    <arg name="ekf_localization_node"         value="false"/>
    <arg name="/localization"                 value="false"/>
    <arg name="/localization/deadreckoning"   value="false"/>
  </include>
</launch>
